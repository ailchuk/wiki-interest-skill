#!/usr/bin/env bash
# Entry point: bash <skill-dir>/scripts/wi <command> [args]
# First run creates <skill-dir>/.venv and installs requirements.txt.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${WI_VENV:-$SKILL_DIR/.venv}"
REQ="$SKILL_DIR/requirements.txt"

find_python() {
  for py in "${PYTHON:-}" python3 python; do
    [ -n "$py" ] || continue
    if command -v "$py" >/dev/null 2>&1 &&
       "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      echo "$py"; return 0
    fi
  done
  return 1
}

venv_python() {
  if [ -x "$VENV/bin/python" ]; then echo "$VENV/bin/python"; else echo "$VENV/Scripts/python.exe"; fi
}

# .installed records where the venv was built: a venv copied to another folder (cp -r of a working copy)
# does not work there, so it is rebuilt from scratch.
if [ ! -f "$VENV/.installed" ] || [ "$REQ" -nt "$VENV/.installed" ] ||
   [ "$(cat "$VENV/.installed" 2>/dev/null)" != "$VENV" ]; then
  PY="$(find_python)" || {
    echo "ERROR: Python 3.10+ not found. Install it (python.org, brew install python, apt install python3) or set PYTHON=/path/to/python3. On Windows, python.exe / python3.exe under WindowsApps is only a Microsoft Store placeholder (exit code 49 or 9009), not Python: do not try other paths or PYTHON values; tell the user to install Python 3.10+ from python.org with \"Add python.exe to PATH\", then stop." >&2
    exit 1
  }
  # --clear and rm -rf below wipe $VENV, so never touch a non-empty folder that is not a venv (e.g. WI_VENV=$HOME).
  if [ -d "$VENV" ] && [ -n "$(ls -A "$VENV")" ] && [ ! -f "$VENV/pyvenv.cfg" ]; then
    echo "ERROR: $VENV exists and is not a Python venv; refusing to overwrite it. Set WI_VENV to a new folder." >&2
    exit 1
  fi
  echo "[wi] first run: creating $VENV and installing dependencies (1-2 min)..." >&2
  "$PY" -m venv --clear "$VENV" || {
    echo "ERROR: could not create venv. On Debian/Ubuntu: sudo apt install python3-venv" >&2
    exit 1
  }
  "$(venv_python)" -m pip install --quiet --disable-pip-version-check -r "$REQ" >&2 || {
    rm -rf "$VENV"
    echo "ERROR: could not install the dependencies in $REQ (see pip's output above): no internet access or a broken Python install. Run the same command once more; nothing is kept from a failed install. If it fails again, tell the user the analysis could not run and why, and stop: do not answer from general knowledge." >&2
    exit 4
  }
  echo "$VENV" > "$VENV/.installed"
fi

export PYTHONIOENCODING=utf-8
exec "$(venv_python)" "$SKILL_DIR/scripts/wi.py" "$@"
