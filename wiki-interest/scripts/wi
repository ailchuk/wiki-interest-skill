#!/usr/bin/env bash
# Entry point: bash <skill-dir>/scripts/wi <command> [args]
# First run creates <skill-dir>/.venv and installs requirements.txt.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${WI_VENV:-$SKILL_DIR/.venv}"
REQ="$SKILL_DIR/requirements.txt"

find_python() {
  for py in "${PYTHON:-}" python3 python; do
    [ -n "$py" ] || continue
    if command -v "$py" >/dev/null 2>&1 &&
       "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      echo "$py"; return 0
    fi
  done
  return 1
}

venv_python() {
  if [ -x "$VENV/bin/python" ]; then echo "$VENV/bin/python"; else echo "$VENV/Scripts/python.exe"; fi
}

if [ ! -f "$VENV/.installed" ] || [ "$REQ" -nt "$VENV/.installed" ]; then
  PY="$(find_python)" || {
    echo "ERROR: Python 3.10+ not found. Install it (python.org, brew install python, apt install python3) or set PYTHON=/path/to/python3." >&2
    exit 1
  }
  echo "[wi] first run: creating $VENV and installing dependencies (1-2 min)..." >&2
  "$PY" -m venv "$VENV" || {
    echo "ERROR: could not create venv. On Debian/Ubuntu: sudo apt install python3-venv" >&2
    exit 1
  }
  "$(venv_python)" -m pip install --quiet --disable-pip-version-check -r "$REQ" >&2
  touch "$VENV/.installed"
fi

export PYTHONIOENCODING=utf-8
exec "$(venv_python)" "$SKILL_DIR/scripts/wi.py" "$@"
